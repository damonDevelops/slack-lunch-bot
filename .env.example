# Required for local development (eval_prompt.py, smoke_test_llm.py)
ANTHROPIC_API_KEY=sk-ant-...

# Required for local Slack bot development (from your Slack app settings)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# Set this to your deployed API Gateway URL when running locally against Slack.
# Without it, the re-auth link shown to users will be a relative path (/slack/install).
# APP_BASE_URL=https://your-api-id.execute-api.ap-southeast-2.amazonaws.com/prod
